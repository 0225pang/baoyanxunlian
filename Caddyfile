(app_proxy) {
  encode zstd gzip
  # The notification bell polls this endpoint every 15 seconds. It is not an
  # operational request, so keep it out of the persistent access audit.
  @notification_poll path /api/notifications
  log_skip @notification_poll
  @realtime path /ws/realtime-asr
  reverse_proxy @realtime realtime-asr:3001
  reverse_proxy app:3000
  request_body {
    max_size 55MB
  }
  handle_errors {
    @app_unavailable expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
    handle @app_unavailable {
      header Content-Type "text/html; charset=utf-8"
      header Retry-After "120"
      respond `<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>服务器维护中</title></head><body style="margin:0;min-height:100vh;display:grid;place-items:center;background:#f6fbf9;color:#16352b;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif"><main style="max-width:430px;margin:24px;padding:44px 36px;border-radius:24px;background:#fff;box-shadow:0 16px 50px rgba(22,53,43,.12);text-align:center"><div style="font-size:42px;margin-bottom:16px">🐟</div><h1 style="margin:0 0 14px;font-size:25px">服务器正在维护当中</h1><p style="margin:0;color:#5b6e66;line-height:1.8">很快上线，请及时关注</p></main></body></html>` 503
    }
  }
}

# Caddy automatically obtains and renews a trusted Let's Encrypt certificate
# for SITE_DOMAIN. Change SITE_DOMAIN in .env if another subdomain is desired.
{$SITE_DOMAIN:baoyan.xiaodaidai.tech} {
  # Persistent structured access audit. It records route, status, duration,
  # response size and client address, but never request/response bodies.
  log {
    output file /var/log/caddy/https-access.json {
      roll_size 50MiB
      roll_keep 1000
      roll_keep_for 876000h
    }
    format json
  }
  # Keep Caddy's default ACME challenge selection. In particular, TLS-ALPN on
  # public TCP 443 avoids any HTTP reverse-proxy or redirect path conflict.
  import app_proxy
}
