(app_proxy) {
  encode zstd gzip
  @realtime path /ws/realtime-asr
  reverse_proxy @realtime realtime-asr:3001
  reverse_proxy app:3000
  request_body {
    max_size 55MB
  }
}

# Keep the existing public-IP HTTP access, for example:
# http://103.236.89.20:18080
:80 {
  import app_proxy
}

# Caddy automatically obtains and renews a trusted Let's Encrypt certificate
# for SITE_DOMAIN. Change SITE_DOMAIN in .env if another subdomain is desired.
{$SITE_DOMAIN:baoyan.xiaodaidai.tech} {
  # Some networks reset the special TLS-ALPN validation handshake. Use the
  # standard HTTP-01 challenge through public TCP port 80 instead.
  tls {
    issuer acme {
      disable_tlsalpn_challenge
    }
  }
  import app_proxy
}
