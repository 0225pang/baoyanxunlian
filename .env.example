# 当前使用服务器 IP + HTTP，正式启用 HTTPS 后请改为 true
COOKIE_SECURE=false

# Trusted HTTPS domain served by Caddy. Keep this aligned with the A record.
# For example: baoyan.xiaodaidai.tech or www.xiaodaidai.tech
SITE_DOMAIN=baoyan.xiaodaidai.tech
# 本地开发使用 SSH 隧道：127.0.0.1:33060 -> 云服务器 127.0.0.1:3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33060
MYSQL_DATABASE=baoyanxunlian
MYSQL_USER=baoyan_app
MYSQL_PASSWORD=填写数据库专用强密码
MYSQL_CONNECTION_LIMIT=10
# Persist only slow/failed SQL templates for incident diagnosis; 0 disables it.
DB_SLOW_QUERY_MS=1000

# Alibaba Cloud Bailian Paraformer ASR (fill the real API key in production)
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=paraformer-v1
DASHSCOPE_ASR_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
# Public base URL that Bailian can access, for example http://103.236.89.20:18080
ASR_PUBLIC_BASE_URL=
# Optional; use a long random value to sign temporary audio URLs
ASR_AUDIO_TOKEN_SECRET=

# Question voice management: locally persisted audio files are exposed through
# a signed URL for Bailian voice cloning. Set this to the public HTTP IP entry.
TTS_PUBLIC_BASE_URL=http://103.236.89.20:18080
# Fill the Beijing/Singapore Workspace URL in the management UI, or set it here
# before first initialization. Example: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/customization
DASHSCOPE_TTS_CLONE_URL=
DASHSCOPE_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2speech/speech-synthesis
DASHSCOPE_TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
